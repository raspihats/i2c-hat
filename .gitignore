/build/
*.map
*.elf
*.bin
*.hex

# Vendor HAL/CMSIS live once in hal/. CubeMX regenerates boards/<name>/Drivers/
# per board, but the build uses hal/ instead — ignore the regenerated copies.
boards/*/Drivers/

# CubeMX's own build system (regenerated alongside Core/; this repo builds
# with the root CMakeLists + cmake/i2c_hat_board.cmake instead).
boards/*/CMakePresets.json
boards/*/cmake/

